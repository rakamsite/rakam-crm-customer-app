<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Rakam CRM</AssemblyName>
    <RootNamespace>Rakam.CustomerApp.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/rakam.ico</ApplicationIcon>
    <Version>0.2.4</Version>
    <Product>Rakam CRM</Product>
    <Title>Rakam CRM</Title>
    <Description>Rakam CRM</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/rakam.ico" LogicalName="Rakam.CustomerApp.rakam.ico" />
    <ProjectReference Include="../Rakam.CustomerApp.Core/Rakam.CustomerApp.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Content Include="../../ui/**"><Link>ui/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content>
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>

